{
  "name": "@projectzero/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent:eval": "node ../../scripts/with-env.mjs tsx evals/run.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.18",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@langchain/ollama": "1.3.0",
    "@projectzero/shared": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@projectzero/config": "workspace:*",
    "@types/node": "26.6.5",
    "tsup": "9.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "tsx": "4.23.15"
  }
}

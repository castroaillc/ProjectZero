# Ports (scripts/wt.ts rewrites these per worktree)
API_PORT=3001
WEB_PORT=3000
DOCS_PORT=3002
DESKTOP_RENDERER_PORT=5173

DATABASE_URL=postgres://postgres:postgres@localhost:5433/projectzero

BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
# Extra comma-separated origins allowed by CORS and Better Auth
TRUSTED_ORIGINS=

# Agent model, served by a local Ollama (`ollama pull gpt-oss:20b`). Must support tool calling.
AGENT_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith tracing: set LANGSMITH_TRACING=true and a key to send agent traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=projectzero-dev

# Ports (scripts/wt.ts rewrites these per worktree)
API_PORT=3001
WEB_PORT=3000
DOCS_PORT=3002
DESKTOP_RENDERER_PORT=5173

DATABASE_URL=postgres://postgres:postgres@localhost:5433/projectzero

BETTER_AUTH_SECRET=change-me
# Base64 32-byte key encrypting stored credentials (`openssl rand -base64 32`). Optional in dev:
# without it a key is derived from BETTER_AUTH_SECRET.
CREDENTIALS_KEY=
BETTER_AUTH_URL=http://localhost:3001
# Extra comma-separated origins allowed by CORS and Better Auth
TRUSTED_ORIGINS=

# Agent model, served by a local Ollama (`ollama pull gpt-oss:20b`). Must support tool calling.
AGENT_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# LangSmith tracing: set LANGSMITH_TRACING=true and a key to send agent traces.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=projectzero-dev

# ProjectZero GitHub App, so agents can clone, push and open PRs. Create one with
# `pnpm github:app [--org <github-org>]`, which fills these in. Leave empty to turn GitHub off.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM on one line with \n escapes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

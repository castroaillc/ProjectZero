    "zod": "4.6.7"
  },
  "devDependencies": {
    "@projectzero/config": "workspace:*",
    "@projectzero/db": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-orm": "0.45.4",
    "electron": "44.9.0",
    "electron-vite": "6.0.0",
    "playwright-core": "1.64.1",
